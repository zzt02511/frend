DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wechat_private_live"
DATABASE_STORAGE="true"
DATABASE_STORAGE="enabled"
POSTGRES_DB="wechat_private_live"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
APP_PORT="3001"
AUTH_SECRET="openssl-rand-base64-32-change-me"
AUTH_URL="https://live.fuguilong.cn"
ROOM_PASSWORD_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
ROOM_PASSWORD_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
LIVEKIT_API_KEY="replace-with-real-livekit-key"
LIVEKIT_API_SECRET="replace-with-real-livekit-secret"
LIVEKIT_URL="wss://live.fuguilong.cn"
WECHAT_OAUTH_APP_ID="replace-with-real-wechat-app-id"
WECHAT_OAUTH_APP_SECRET="replace-with-real-wechat-app-secret"
TENCENT_RTMP_PUSH_DOMAIN=push.fuguilong.cn
TENCENT_RTMP_APP_NAME=live
# Tencent Cloud console: push.fuguilong.cn > 推流配置 > 鉴权 Key
TENCENT_RTMP_PUSH_KEY=
TENCENT_RTMP_URL_TTL_SECONDS=43200
# TCPlayer 5.x Web License URL. This is embedded at Next.js build time.
# Apply for the free Web Player Basic License and bind live.fuguilong.cn.
NEXT_PUBLIC_TENCENT_PLAYER_LICENSE_URL=
